# ============================================================================
# Aestho Portfolio — environment template
# ============================================================================
# Copy this file to .env.local for local dev. On Vercel, set each variable
# under Project Settings → Environment Variables. NEVER commit .env.local.
#
# Public vs private: Next.js inlines every variable that starts with
# NEXT_PUBLIC_ into the browser bundle at build time. Anything else stays
# server-only. The rule below is enforced by audit; if you see a secret
# under NEXT_PUBLIC_ here, that's a bug.
# ============================================================================

# ---- Public (browser-safe — these end up in the client bundle) ----

# PostHog browser SDK. The "key" here is the public ph_* project key, NOT
# the personal API key. Designed for browser use; cannot read or write
# your account.
NEXT_PUBLIC_POSTHOG_KEY=phc_…
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity project id. Public by design — Clarity scripts always
# expose it.
NEXT_PUBLIC_CLARITY_PROJECT_ID=…

# Public canonical URL of the site. Drives sitemap, robots, OG, structured
# data, and dashboard auth cookie scope.
NEXT_PUBLIC_SITE_URL=https://www.aestho.xyz

# Google Analytics measurement id. Defaults are baked in; only override here
# if you rotate the property. Public by design.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-…

# Optional: Tidio chat widget. Leave blank to disable the script.
# NEXT_PUBLIC_TIDIO_KEY=…

# Optional: Senja embed widget id (testimonials section).
# NEXT_PUBLIC_SENJA_WIDGET_ID=…

# ---- Private (server-only — NEVER prefix any of these with NEXT_PUBLIC_) ----

# Neon Postgres connection string for the analytics + auth + inbox database.
# Use the pooler endpoint for Vercel deploys.
DATABASE_URL=postgresql://neondb_owner:…@…neon.tech/neondb?channel_binding=require&sslmode=require

# Dashboard auth. SESSION_SECRET signs the session JWT — must be at least
# 32 random bytes. ALLOWED_EMAIL is the only address that can request an
# OTP; comma-separate to allowlist multiple admins.
DASHBOARD_SESSION_SECRET=<32-byte-hex>
DASHBOARD_ALLOWED_EMAIL=rashidiqbal.freelance@gmail.com

# Resend transactional email. The from-email must be a Resend-verified
# sending domain.
RESEND_API_KEY=re_…
RESEND_FROM_EMAIL=mail@yourdomain.com

# Web3Forms (legacy fallback for /api/contact and /api/audit/lead). Used
# server-side only — DO NOT add a NEXT_PUBLIC_ mirror of this value.
WEB3FORMS_KEY=…

# IndexNow / Bing protocol key. Bing requires it served at /<key>.txt for
# domain verification, so the value is technically public per spec — but
# we still keep it as a server-only env so it doesn't get inlined into
# arbitrary client code by accident.
INDEXNOW_KEY=…
# Optional: gates manual sync calls when CRON_SECRET isn't set.
# INDEXNOW_SYNC_SECRET=…

# Vercel-injected. Used by /api/indexnow/sync-sitemap to authenticate the
# scheduled cron call. Vercel sets this automatically on deploy; uncomment
# only for local cron simulation.
# CRON_SECRET=…

# PostHog source-map upload (build-time only). Read by next.config.ts
# during the build pipeline; never bundled at runtime.
POSTHOG_PERSONAL_API_KEY=phx_…

# Optional: explicit overrides for posthog-server (used in route handlers
# that capture errors server-side). When unset, the public NEXT_PUBLIC_
# values above are reused server-side.
# POSTHOG_KEY=phc_…
# POSTHOG_HOST=https://us.i.posthog.com
